PORT=4000
NODE_ENV=development

# PostgreSQL connection string, e.g. postgres://user:password@localhost:5432/dbname
DATABASE_URL=postgres://user:password@localhost:5432/doc_intel

# Redis URL for BullMQ jobs
REDIS_URL=redis://localhost:6379

# API key(s) for calling this backend (comma-separated if multiple)
API_KEYS=dev-api-key-1

# Claude / LLM configuration (placeholder; wire to your actual provider)
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-3-5-sonnet-latest
CLAUDE_PROMPT_VERSION=PROMPT_VERSION_1

