PORT=4000
NODE_ENV=development

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5713

# ── Database ──────────────────────────────────────────────────
# Local:      postgres://sie_user:sie_password@localhost:5432/statement_intel
# Docker:     postgres://sie_user:sie_password@postgres:5432/statement_intel
# Render:     (auto-injected from managed Postgres)
DATABASE_URL=postgres://sie_user:sie_password@localhost:5432/statement_intel

# ── Redis ─────────────────────────────────────────────────────
# Local:      redis://localhost:6379
# Docker:     redis://redis:6379
# Upstash:    rediss://default:xxxxx@your-db.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────
# Comma-separated API keys. If unset, auth is disabled (dev mode).
API_KEYS=dev-api-key-1

# ── Claude / LLM ─────────────────────────────────────────────
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_PROMPT_VERSION=PROMPT_VERSION_1

# ── File storage ──────────────────────────────────────────────
UPLOADS_DIR=data/uploads

# ── Production only (docker-compose.prod.yml) ────────────────
# POSTGRES_USER=sie_user
# POSTGRES_PASSWORD=change-me-in-production
# POSTGRES_DB=statement_intel
# REDIS_PASSWORD=change-me-in-production
